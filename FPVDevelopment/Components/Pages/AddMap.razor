@page "/AddMap"
@inject MapService MapService;
@inject SimService SimService;
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<EditForm FormName="AddMapForm" Model="@_map" OnSubmit="@HandleSubmit">
    <MudGrid Edge="Edge.Start" Class="mr-16">
        <MudItem xs="12" sm="7">
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">Add a new map to the database.</MudText>
                </MudCardHeader>
                <MudCardContent Class="p-2 pt-1">
                    <MudStack Spacing="4">
                        <MudSelect  @bind-Value="@_sim.ID" Label="Select a Sim">
                            @foreach (var sim in _simList
                                          .OrderBy(s => s.Name))
                            {
                                <MudSelectItem Value="@sim.ID">@sim.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField Label="Map Name" HelperText="Max. 50 characters"
                                      @bind-Value="@_map.Name"></MudTextField>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton
                        ButtonType="ButtonType.Submit"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        disabled="@IsSubmitDisabled">
                        Add Map
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private readonly Map _map = new Map();

    private IList<Sim> _simList = [];
    private Sim _sim = new Sim();
    
    private bool IsSubmitDisabled =>
        string.IsNullOrWhiteSpace(_map.Name);
    
    protected override async Task OnInitializedAsync()
    {
        _simList = await SimService.GetSims();
    }

    private async Task HandleSubmit(EditContext editContext)
    {
        var newMap = new Map
        {
            Name = _map.Name,
            SimID = _sim.ID
        };
        
        var flag = await MapService.AddMap(newMap);
        if (flag)
            Snackbar.Add("Map Added!", Severity.Success);
        else
            Snackbar.Add("Map Failed To Add", Severity.Error);
    }
}