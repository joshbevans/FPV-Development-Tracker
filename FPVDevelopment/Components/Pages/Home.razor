@page "/"
@inject UserService UserService
@inject CurrentUser CurrentUser
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<MudStack Edge="Edge.Start" Class="pa-4 mr-16">
    <label>Logged in as @CurrentUser.User?.DisplayName</label>
    <MudButton
        hidden="@IsUserLoggedIn"
        FullWidth="false"
        Style="width: 200px;"
        Variant="Variant.Filled"
        Color="Color.Primary"
        @onclick='() => HandleLoginUser("melon")'>
        Login Admin
    </MudButton>
    <MudButton
        hidden="@IsUserLoggedIn"
        FullWidth="false"
        Style="width: 200px;"
        Variant="Variant.Filled"
        Color="Color.Primary"
        @onclick='() => HandleLoginUser("melonBasic")'>
        Login User
    </MudButton>
</MudStack>

@code {
    
    protected override void OnInitialized()
    {
        CurrentUser.CurrentUserChangedEvent += OnCurrentUserChanged;
    }

    private void OnCurrentUserChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUser.CurrentUserChangedEvent -= OnCurrentUserChanged;
    }

    private bool IsUserLoggedIn =>
        CurrentUser.User is not null;
        
    private async Task HandleLoginUser(string userSelect)
    {
        CurrentUser.SetCurrentUser(await UserService.Login(userSelect, "pass"));
        if (CurrentUser.User is not null)
        {
            Snackbar.Add("Login Successful!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Login Failed!", Severity.Error);
        }
    }
}